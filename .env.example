# Publisher/developer build configuration only. Normal OmniCode users never set
# these values. Prefer an absolute path to a Google Desktop app credentials JSON.
OMNICODE_GOOGLE_OAUTH_CREDENTIALS_FILE=/absolute/path/to/client_secret_desktop.apps.googleusercontent.com.json

# Mark only a development client whose Google Auth Platform publishing status is
# Testing. Production publisher builds must omit this or set it to 0.
OMNICODE_GOOGLE_OAUTH_TESTING=1
